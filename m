Spotted in the Chrome OS 3.8 based device tree.
Needs CONFIG_SENSORS_LM90.

Signed-off-by: Andreas F=C3=A4rber <afaerber-l3A5Bk7waGM@public.gmane.org>
---
 arch/arm/boot/dts/exynos5250-spring.dts | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/arch/arm/boot/dts/exynos5250-spring.dts b/arch/arm/boot/dt=
s/exynos5250-spring.dts
index 310764b6e28d..cc3361afba49 100644
--- a/arch/arm/boot/dts/exynos5250-spring.dts
+++ b/arch/arm/boot/dts/exynos5250-spring.dts
@@ -383,6 +383,11 @@
 	status =3D "okay";
 	samsung,i2c-sda-delay =3D <100>;
 	samsung,i2c-max-bus-freq =3D <66000>;
+
+	temperature-sensor@4c {
+		compatible =3D "gmt,g781";
+		reg =3D <0x4c>;
+	};
 };
=20
 &i2c_8 {
--=20
