diff --git a/arch/arm/Makefile b/arch/arm/Makefile
index 6613568..12a8da9 100644
--- a/arch/arm/Makefile
+++ b/arch/arm/Makefile
@@ -438,6 +438,14 @@ PHONY += imote2_defconfig
 imote2_defconfig:
 	$(call merge_into_defconfig,pxa_basic3_defconfig,imote2)
 
+PHONY += exynos_defconfig
+exynos_defconfig:
+	$(call merge_into_defconfig,dummy_defconfig,exynos/hw_y exynos/hw_y_shared exynos/hw_m exynos/hw_m_shared exynos/sys_y exynos/sys_y_shared)
+
+PHONY += multi_v7_defconfig
+multi_v7_defconfig:
+	$(call merge_into_defconfig,multi_v7_base_defconfig,exynos/hw_y_shared exynos/hw_m_shared exynos/sys_y_shared)
+
 PHONY += vdso_install
 vdso_install:
 ifeq ($(CONFIG_VDSO),y)
